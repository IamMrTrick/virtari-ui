{
  "name": "@virtari/react-scroll-area",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./styles": {
      "style": "./dist/ScrollArea.css",
      "default": "./dist/ScrollArea.css"
    },
    "./tokens": {
      "style": "./dist/ScrollArea.tokens.css",
      "default": "./dist/ScrollArea.tokens.css"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup && postcss src/ScrollArea.tokens.css -o dist/ScrollArea.tokens.css && postcss src/ScrollArea.css -o dist/ScrollArea.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@virtari/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.5",
    "@types/react": "^19.2.14",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0"
  }
}
