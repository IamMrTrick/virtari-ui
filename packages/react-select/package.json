{
  "name": "@virtari/react-select",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "style": "./dist/Select.css",
      "default": "./dist/Select.css"
    },
    "./tokens": {
      "style": "./dist/Select.tokens.css",
      "default": "./dist/Select.tokens.css"
    },
    "./combobox/styles": {
      "style": "./dist/Combobox.css",
      "default": "./dist/Combobox.css"
    },
    "./combobox/tokens": {
      "style": "./dist/Combobox.tokens.css",
      "default": "./dist/Combobox.tokens.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && postcss src/Select.tokens.css -o dist/Select.tokens.css && postcss src/Select.css -o dist/Select.css && postcss src/Combobox.tokens.css -o dist/Combobox.tokens.css && postcss src/Combobox.css -o dist/Combobox.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-virtual": "^3.10.0",
    "@virtari/react-chip": "workspace:*",
    "@virtari/react-icons": "workspace:*",
    "@virtari/utils": "workspace:*"
  },
  "peerDependencies": {
    "@tabler/icons-react": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.0.0",
    "react": "^19.2.5",
    "@types/react": "^19.2.14",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0"
  }
}
