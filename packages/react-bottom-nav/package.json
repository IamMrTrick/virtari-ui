{
  "name": "@virtari-packages/react-bottom-nav",
  "version": "0.2.0",
  "description": "Virtari bottom navigation — mobile-first tab bar with Material 3 / iOS / Floating / Underline variants, FAB, badges, safe-area insets, auto-hide, and animated indicator.",
  "license": "UNLICENSED",
  "author": "Virtari",
  "homepage": "https://github.com/IamMrTrick/virtari-design-system/tree/main/packages/react-bottom-nav#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamMrTrick/virtari-design-system.git",
    "directory": "packages/react-bottom-nav"
  },
  "bugs": {
    "url": "https://github.com/IamMrTrick/virtari-design-system/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "components",
    "bottom-nav",
    "tab-bar",
    "mobile",
    "navigation",
    "bottom",
    "nav"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": "./dist/BottomNav.css",
    "./tokens": "./dist/BottomNav.tokens.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup && postcss src/BottomNav.tokens.css -o dist/BottomNav.tokens.css && postcss src/BottomNav.css -o dist/BottomNav.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@virtari-packages/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.5",
    "@types/react": "^19.2.14",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0"
  }
}
