{
  "name": "@virtari/react-table",
  "version": "0.1.0",
  "description": "Virtari table — accessible React component built on CSS variables and logical properties.",
  "license": "UNLICENSED",
  "author": "Virtari",
  "homepage": "https://github.com/IamMrTrick/virtari-design-system/tree/main/packages/react-table#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamMrTrick/virtari-design-system.git",
    "directory": "packages/react-table"
  },
  "bugs": {
    "url": "https://github.com/IamMrTrick/virtari-design-system/issues"
  },
  "keywords": [
    "virtari",
    "design-system",
    "react",
    "ui",
    "components",
    "table"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles": {
      "style": "./dist/Table.css",
      "default": "./dist/Table.css"
    },
    "./tokens": {
      "style": "./dist/Table.tokens.css",
      "default": "./dist/Table.tokens.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup && postcss src/Table.tokens.css -o dist/Table.tokens.css && postcss src/Table.css -o dist/Table.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@virtari/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.5",
    "@types/react": "^19.2.14",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0"
  }
}
