node_modules

# Build output
apps/docs/dist

# Logs
*.log
.tmp-*
.codex-*
tmp-*.txt
vite-out.txt
vite-err.txt

# Browser/debug profiles
.chrome-*
.chrome-headless-check
.chrome-stepper-*
.chrome-timeline-*

# Local config
.npmrc
.claude/scheduled_tasks.lock

# Agent worktrees (full repo copies) + local-only settings
.claude/worktrees/
.claude/settings.local.json

# Package build output — regenerated by `pnpm build`; the release
# workflow rebuilds before publishing, so it never belongs in git.
packages/*/dist
